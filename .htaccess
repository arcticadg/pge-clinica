# ── Página inicial ─────────────────────────────────────────────────────────
DirectoryIndex index.html index.php

# ── Bloqueia arquivos sensíveis (NÃO inclui config.json — lido pelo JS) ───
<FilesMatch "^(credentials\.php|rate_limit\.json)$">
    Require all denied
</FilesMatch>

# ── Restringe admin.php por IP ─────────────────────────────────────────────
# Adicione aqui os IPs autorizados a acessar o painel.
# Para liberar temporariamente para qualquer IP, comente este bloco.
<Files "admin.php">
    Require all granted
    # Para restringir por IP, substitua a linha acima por:
    # Require ip SEU.IP.AQUI
</Files>

# ── Bloqueia listagem de diretórios ────────────────────────────────────────
Options -Indexes

# ── Bloqueia PHP na pasta uploads ──────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^uploads/.*\.php$ - [F,L]
</IfModule>

# ── Headers de segurança ───────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
