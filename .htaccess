# ── Página inicial ─────────────────────────────────────────────────────────
DirectoryIndex index.html index.php

# ── Bloqueia arquivos sensíveis ────────────────────────────────────────────
<FilesMatch "^(credentials\.php|rate_limit\.json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Bloqueia listagem de diretórios ────────────────────────────────────────
Options -Indexes

# ── Bloqueia PHP na pasta uploads ──────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^uploads/.*\.php$ - [F,L]
</IfModule>
